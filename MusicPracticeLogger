<!DOCTYPE html>
<html lang="en" ng-app="practiceTempoApp">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PracticeTempo - Musician Practice Tracker</title>
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Font Awesome 6 Icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <!-- AngularJS 1.8.2 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.8.2/angular.min.js"></script>
  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <style>
    :root {
      --bg-dark: #111318;
      --bg-card: #1a1d24;
      --bg-card-hover: #222630;
      --bg-card-active: #172a24;
      --accent-cyan: #00f2fe;
      --accent-green: #10b981;
      --accent-amber: #f59e0b;
      --accent-purple: #a855f7;
      --accent-rose: #f43f5e;
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --border-color: #2e3440;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      min-height: 100vh;
      padding-bottom: 90px; /* Space for sticky playback bar on mobile */
      user-select: none;
      -webkit-user-select: none;
    }

    /* High contrast text for music stand legibility */
    .stand-text-lg {
      font-size: 1.4rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }

    .stand-text-xl {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    /* Custom Cards */
    .tempo-card {
      background-color: var(--bg-card);
      border: 2px solid var(--border-color);
      border-radius: 16px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .tempo-card:hover {
      background-color: var(--bg-card-hover);
      transform: translateY(-2px);
      border-color: #4b5563;
    }

    .tempo-card.active-playing {
      background-color: var(--bg-card-active);
      border-color: var(--accent-green);
      box-shadow: 0 0 20px rgba(16, 185, 129, 0.25);
    }

    /* Touch buttons minimum size for iPhone */
    .btn-touch {
      min-height: 48px;
      padding: 10px 18px;
      font-weight: 600;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-touch-lg {
      min-height: 56px;
      font-size: 1.1rem;
      border-radius: 14px;
    }

    /* Category Badges */
    .cat-badge {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 4px 10px;
      border-radius: 20px;
    }

    .cat-warmup { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.4); }
    .cat-scales { background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); }
    .cat-repertoire { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.4); }
    .cat-sightreading { background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); }
    .cat-technique { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.4); }

    /* Equalizer Bar Animation */
    .eq-container {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      height: 20px;
    }

    .eq-bar {
      width: 4px;
      background-color: var(--accent-green);
      border-radius: 2px;
      animation: eqBounce 1s infinite ease-in-out alternate;
    }

    .eq-bar:nth-child(1) { animation-delay: 0.1s; height: 60%; }
    .eq-bar:nth-child(2) { animation-delay: 0.4s; height: 100%; }
    .eq-bar:nth-child(3) { animation-delay: 0.2s; height: 40%; }
    .eq-bar:nth-child(4) { animation-delay: 0.5s; height: 80%; }

    @keyframes eqBounce {
      0% { height: 20%; }
      100% { height: 100%; }
    }

    /* Metronome Beat Indicator Flashes */
    .beat-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background-color: #374151;
      transition: background-color 0.1s ease, transform 0.1s ease;
    }

    .beat-dot.active {
      background-color: var(--accent-cyan);
      box-shadow: 0 0 10px var(--accent-cyan);
      transform: scale(1.25);
    }

    .beat-dot.active-accent {
      background-color: var(--accent-amber);
      box-shadow: 0 0 12px var(--accent-amber);
      transform: scale(1.35);
    }

    /* Range slider custom styling */
    .form-range::-webkit-slider-thumb {
      background: var(--accent-cyan);
      width: 24px;
      height: 24px;
      border-radius: 50%;
    }

    /* Floating / Sticky Mobile Player */
    .sticky-player-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(26, 29, 36, 0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--border-color);
      z-index: 1050;
      padding: 12px 16px;
    }

    /* Custom Dark Modal */
    .modal-content-dark {
      background-color: var(--bg-card);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: 20px;
    }

    .form-dark {
      background-color: #121418;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: 10px;
      padding: 12px;
    }

    .form-dark:focus {
      background-color: #121418;
      color: #fff;
      border-color: var(--accent-cyan);
      box-shadow: 0 0 0 0.25rem rgba(0, 242, 254, 0.15);
    }

    .progress {
      background-color: #2d333f;
      border-radius: 10px;
      height: 8px;
    }
  </style>
</head>

<body ng-controller="PracticeController as vm">
  <!-- Top App Navigation Header -->
  <header class="navbar navbar-dark bg-dark border-bottom border-secondary px-3 py-2 sticky-top">
    <div class="container-fluid d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-music text-info fs-3"></i>
        <div>
          <h1 class="h4 mb-0 fw-bold text-white">PracticeTempo</h1>
          <span class="small text-muted d-none d-sm-inline">Musician Studio Companion</span>
        </div>
      </div>

      <!-- Live Session Time Counter -->
      <div class="d-flex align-items-center gap-3">
        <div class="text-end">
          <div class="small text-muted uppercase tracking-wider fw-semibold">SESSION TIME</div>
          <div class="font-monospace fw-bold fs-4 text-emerald" style="color: var(--accent-green)">
            {{ vm.formatTime(vm.sessionTotalSeconds) }}
          </div>
        </div>

        <!-- Quick Action Buttons -->
        <button class="btn btn-outline-light btn-touch" ng-click="vm.toggleMetronomeDrawer()" title="Metronome">
          <i class="fa-solid fa-metronome" ng-class="{'text-info': vm.metronome.isPlaying}"></i>
          <span class="d-none d-md-inline">Metronome</span>
        </button>

        <button class="btn btn-info btn-touch text-dark fw-bold" ng-click="vm.openAddTaskModal()">
          <i class="fa-solid fa-plus"></i>
          <span class="d-none d-sm-inline">Add Piece</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Collapsible Metronome Drawer -->
  <div class="bg-dark border-bottom border-secondary py-3 px-3" ng-show="vm.showMetronome">
    <div class="container">
      <div class="row align-items-center g-3">
        <div class="col-12 col-md-4 d-flex align-items-center justify-content-between justify-content-md-start gap-3">
          <!-- Play/Stop Metronome -->
          <button class="btn btn-touch-lg px-4" 
                  ng-class="vm.metronome.isPlaying ? 'btn-danger' : 'btn-success'" 
                  ng-click="vm.toggleMetronome()">
            <i class="fa-solid" ng-class="vm.metronome.isPlaying ? 'fa-square' : 'fa-play'"></i>
            <span>{{ vm.metronome.isPlaying ? 'STOP' : 'START' }}</span>
          </button>

          <!-- BPM Display -->
          <div class="text-center">
            <span class="stand-text-xl font-monospace text-info">{{ vm.metronome.bpm }}</span>
            <span class="small text-muted d-block">BPM</span>
          </div>

          <!-- Tap Tempo -->
          <button class="btn btn-outline-secondary btn-touch px-3" ng-click="vm.tapTempo()" title="Tap rhythm to set tempo">
            <i class="fa-solid fa-fingerprint"></i>
            <span>TAP</span>
          </button>
        </div>

        <!-- BPM Slider & Fine Adjustments -->
        <div class="col-12 col-md-5">
          <div class="d-flex align-items-center gap-2 mb-2">
            <button class="btn btn-sm btn-outline-secondary px-2" ng-click="vm.adjustBpm(-5)">-5</button>
            <button class="btn btn-sm btn-outline-secondary px-2" ng-click="vm.adjustBpm(-1)">-1</button>
            <input type="range" class="form-range flex-grow-1" min="30" max="250" ng-model="vm.metronome.bpm" ng-change="vm.updateMetronomeTempo()">
            <button class="btn btn-sm btn-outline-secondary px-2" ng-click="vm.adjustBpm(1)">+1</button>
            <button class="btn btn-sm btn-outline-secondary px-2" ng-click="vm.adjustBpm(5)">+5</button>
          </div>

          <!-- Tempo Presets -->
          <div class="d-flex justify-content-between text-muted small">
            <span class="badge bg-secondary cursor-pointer" ng-click="vm.setBpm(60)">Adagio (60)</span>
            <span class="badge bg-secondary cursor-pointer" ng-click="vm.setBpm(84)">Andante (84)</span>
            <span class="badge bg-secondary cursor-pointer" ng-click="vm.setBpm(108)">Moderato (108)</span>
            <span class="badge bg-secondary cursor-pointer" ng-click="vm.setBpm(132)">Allegro (132)</span>
            <span class="badge bg-secondary cursor-pointer" ng-click="vm.setBpm(168)">Presto (168)</span>
          </div>
        </div>

        <!-- Time Signature & Visual Beats -->
        <div class="col-12 col-md-3 d-flex flex-column align-items-md-end align-items-center">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="small text-muted">Time Sig:</span>
            <div class="btn-group btn-group-sm">
              <button class="btn" ng-class="vm.metronome.timeSignature === 2 ? 'btn-info' : 'btn-outline-secondary'" ng-click="vm.setSignature(2)">2/4</button>
              <button class="btn" ng-class="vm.metronome.timeSignature === 3 ? 'btn-info' : 'btn-outline-secondary'" ng-click="vm.setSignature(3)">3/4</button>
              <button class="btn" ng-class="vm.metronome.timeSignature === 4 ? 'btn-info' : 'btn-outline-secondary'" ng-click="vm.setSignature(4)">4/4</button>
              <button class="btn" ng-class="vm.metronome.timeSignature === 6 ? 'btn-info' : 'btn-outline-secondary'" ng-click="vm.setSignature(6)">6/8</button>
            </div>
          </div>

          <!-- Beat Flashing Dots -->
          <div class="d-flex gap-2 align-items-center">
            <div ng-repeat="beat in vm.getBeatArray() track by $index" 
                 class="beat-dot" 
                 ng-class="{
                   'active': vm.metronome.isPlaying && vm.metronome.currentBeat === $index,
                   'active-accent': vm.metronome.isPlaying && vm.metronome.currentBeat === $index && $index === 0
                 }">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="container my-4">
    <!-- Spotlight: Active Running Task Banner -->
    <div class="card bg-dark border-success text-white mb-4 shadow-lg" ng-if="vm.activeTask">
      <div class="card-body p-3 p-md-4">
        <div class="row align-items-center g-3">
          <div class="col-12 col-md-6">
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="badge bg-success text-dark fw-bold">NOW PLAYING</span>
              <span class="cat-badge" ng-class="vm.getCategoryClass(vm.activeTask.category)">{{ vm.activeTask.category }}</span>
              <div class="eq-container ms-2" ng-if="!vm.isPaused">
                <div class="eq-bar"></div>
                <div class="eq-bar"></div>
                <div class="eq-bar"></div>
                <div class="eq-bar"></div>
              </div>
            </div>
            <h2 class="stand-text-lg mb-1 text-white">{{ vm.activeTask.title }}</h2>
            <div class="text-info font-monospace fw-semibold fs-5 mb-1" ng-if="vm.activeTask.bars">
              <i class="fa-solid fa-bookmark me-1"></i> {{ vm.activeTask.bars }}
            </div>
            <p class="text-muted small mb-0" ng-if="vm.activeTask.notes">
              <i class="fa-solid fa-lightbulb text-warning me-1"></i> Focus: {{ vm.activeTask.notes }}
            </p>
          </div>

          <!-- Live Timer & Play Controls -->
          <div class="col-12 col-md-6 text-md-end">
            <div class="d-flex align-items-center justify-content-md-end justify-content-between gap-3 mb-2">
              <div>
                <div class="small text-muted">TASK TIME</div>
                <div class="stand-text-xl font-monospace text-emerald" style="color: var(--accent-green)">
                  {{ vm.formatTime(vm.activeTask.secondsSpent) }}
                </div>
              </div>
              <div class="text-end">
                <div class="small text-muted">PLANNED</div>
                <div class="stand-text-lg font-monospace text-muted">
                  {{ vm.activeTask.plannedMinutes }}m
                </div>
              </div>
            </div>

            <div class="d-flex gap-2 justify-content-md-end">
              <button class="btn btn-touch" ng-class="vm.isPaused ? 'btn-success' : 'btn-warning'" ng-click="vm.togglePauseTask()">
                <i class="fa-solid" ng-class="vm.isPaused ? 'fa-play' : 'fa-pause'"></i>
                <span>{{ vm.isPaused ? 'Resume' : 'Pause' }}</span>
              </button>

              <button class="btn btn-outline-light btn-touch" ng-click="vm.stopActiveTask()">
                <i class="fa-solid fa-stop"></i>
                <span>Stop</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Progress Bar for Active Task -->
        <div class="mt-3">
          <div class="d-flex justify-content-between small text-muted mb-1">
            <span>Progress towards goal</span>
            <span>{{ vm.getTaskProgressPercent(vm.activeTask) }}%</span>
          </div>
          <div class="progress" style="height: 10px;">
            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" 
                 role="progressbar" 
                 ng-style="{'width': vm.getTaskProgressPercent(vm.activeTask) + '%'}">
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter Tabs & Summary Row -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <!-- Category Filter Pills -->
      <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-touch" 
                ng-class="vm.selectedCategory === 'All' ? 'btn-light' : 'btn-outline-secondary'"
                ng-click="vm.filterCategory('All')">
          All ({{ vm.tasks.length }})
        </button>
        <button class="btn btn-sm btn-touch" 
                ng-class="vm.selectedCategory === cat ? 'btn-light' : 'btn-outline-secondary'"
                ng-repeat="cat in vm.categories"
                ng-click="vm.filterCategory(cat)">
          {{ cat }}
        </button>
      </div>

      <!-- Quick Action Controls -->
      <div class="d-flex align-items-center gap-2">
        <button class="btn btn-outline-secondary btn-sm" ng-click="vm.openStatsModal()" title="View Practice Analytics">
          <i class="fa-solid fa-chart-pie me-1"></i> Analytics
        </button>
        <button class="btn btn-outline-danger btn-sm" ng-click="vm.resetAllSessionPrompt()" title="Reset Session Timers">
          <i class="fa-solid fa-rotate-left me-1"></i> Reset Times
        </button>
      </div>
    </div>

    <!-- Instructions banner if no running task -->
    <div class="alert alert-dark border-secondary d-flex align-items-center gap-3 mb-4" ng-if="!vm.activeTask">
      <i class="fa-solid fa-hand-pointer text-info fs-3"></i>
      <div>
        <strong class="text-white">One-Tap Practice Switcher:</strong> Tap any piece card below to immediately start timing that item. Tapping a new piece automatically stops and logs the previous one.
      </div>
    </div>

    <!-- Task Cards Grid -->
    <div class="row g-3">
      <div class="col-12 col-md-6 col-lg-4" ng-repeat="task in vm.filteredTasks = (vm.tasks | filter:vm.categoryFilter) track by task.id">
        <div class="tempo-card p-3 h-100 d-flex flex-column justify-content-between" 
             ng-class="{'active-playing': vm.activeTask.id === task.id}"
             ng-click="vm.selectTask(task)">
          
          <div>
            <!-- Card Header: Category & Action Buttons -->
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="cat-badge" ng-class="vm.getCategoryClass(task.category)">{{ task.category }}</span>
              
              <div class="d-flex gap-1" ng-click="$event.stopPropagation()">
                <button class="btn btn-link text-muted p-1" ng-click="vm.openEditTaskModal(task)" title="Edit Piece">
                  <i class="fa-solid fa-pen-to-square"></i>
                </button>
                <button class="btn btn-link text-danger p-1" ng-click="vm.deleteTask(task.id)" title="Delete Piece">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>

            <!-- Piece Name & Measure Range -->
            <h3 class="stand-text-lg text-white mb-1">{{ task.title }}</h3>
            
            <div class="text-info font-monospace fw-semibold mb-2" ng-if="task.bars">
              <i class="fa-solid fa-bookmark me-1"></i> {{ task.bars }}
            </div>

            <!-- Technique / Goal Notes -->
            <p class="text-muted small mb-3 text-truncate-2" ng-if="task.notes">
              <i class="fa-solid fa-bullseye text-warning me-1"></i> {{ task.notes }}
            </p>
          </div>

          <!-- Card Bottom: Elapsed Time, Target & Tap Action -->
          <div>
            <!-- Target vs Spent Info -->
            <div class="d-flex justify-content-between align-items-end mb-2">
              <div>
                <span class="small text-muted d-block">Time Spent</span>
                <span class="font-monospace fw-bold fs-5 text-white">
                  {{ vm.formatTime(task.secondsSpent) }}
                </span>
              </div>
              <div class="text-end">
                <span class="small text-muted d-block">Goal</span>
                <span class="font-monospace fw-semibold text-muted">
                  {{ task.plannedMinutes }} min
                </span>
              </div>
            </div>

            <!-- Goal Progress Bar -->
            <div class="progress mb-3">
              <div class="progress-bar" 
                   role="progressbar" 
                   ng-class="vm.getProgressColorClass(vm.getTaskProgressPercent(task))"
                   ng-style="{'width': vm.getTaskProgressPercent(task) + '%'}">
              </div>
            </div>

            <!-- Big Touch Tap Indicator Button -->
            <button class="btn btn-touch w-full w-100" 
                    ng-class="vm.activeTask.id === task.id ? 'btn-success fw-bold' : 'btn-outline-info'">
              <i class="fa-solid" ng-class="vm.activeTask.id === task.id ? (vm.isPaused ? 'fa-play' : 'fa-volume-high') : 'fa-play'"></i>
              <span>
                <span ng-if="vm.activeTask.id === task.id">
                  {{ vm.isPaused ? 'PAUSED - TAP TO RESUME' : 'NOW PLAYING' }}
                </span>
                <span ng-if="vm.activeTask.id !== task.id">
                  TAP TO START
                </span>
              </span>
            </button>
          </div>

        </div>
      </div>

      <!-- Empty State -->
      <div class="col-12 text-center py-5" ng-if="vm.filteredTasks.length === 0">
        <i class="fa-solid fa-music text-muted fs-1 mb-3"></i>
        <h3 class="h5 text-muted">No pieces found in this category</h3>
        <button class="btn btn-info btn-touch text-dark mt-2" ng-click="vm.openAddTaskModal()">
          <i class="fa-solid fa-plus"></i> Add New Piece
        </button>
      </div>
    </div>
  </main>

  <!-- Floating Sticky Bottom Bar for Mobile (iPhone Optimization) -->
  <div class="sticky-player-bar d-md-none" ng-if="vm.activeTask">
    <div class="d-flex align-items-center justify-content-between gap-2">
      <div class="text-truncate flex-grow-1" ng-click="vm.scrollToActiveTask()">
        <div class="small text-success fw-bold text-uppercase d-flex align-items-center gap-1">
          <span class="spinner-grow spinner-grow-sm text-success" role="status" ng-if="!vm.isPaused"></span>
          {{ vm.isPaused ? 'PAUSED' : 'NOW PLAYING' }}
        </div>
        <div class="fw-bold text-white text-truncate">{{ vm.activeTask.title }}</div>
      </div>

      <div class="font-monospace fw-bold fs-4 text-emerald me-2" style="color: var(--accent-green)">
        {{ vm.formatTime(vm.activeTask.secondsSpent) }}
      </div>

      <button class="btn btn-touch" ng-class="vm.isPaused ? 'btn-success' : 'btn-warning'" ng-click="vm.togglePauseTask()">
        <i class="fa-solid" ng-class="vm.isPaused ? 'fa-play' : 'fa-pause'"></i>
      </button>
    </div>
  </div>

  <!-- Modal: Add / Edit Piece -->
  <div class="modal fade" id="taskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-secondary">
          <h5 class="modal-title fw-bold text-white">
            <i class="fa-solid text-info me-2" ng-class="vm.editingTask.id ? 'fa-pen-to-square' : 'fa-plus-circle'"></i>
            {{ vm.editingTask.id ? 'Edit Practice Piece' : 'Add New Practice Piece' }}
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <form ng-submit="vm.saveTask()">
          <div class="modal-body">
            <!-- Piece Title -->
            <div class="mb-3">
              <label class="form-label small text-muted fw-bold">PIECE / WORK NAME *</label>
              <input type="text" class="form-control form-dark" ng-model="vm.editingTask.title" placeholder="e.g. Chopin Nocturne Op. 9 No. 2" required>
            </div>

            <!-- Measure / Bar Range -->
            <div class="mb-3">
              <label class="form-label small text-muted fw-bold">BAR / MEASURE FOCUS</label>
              <input type="text" class="form-control form-dark" ng-model="vm.editingTask.bars" placeholder="e.g. m. 14-28 or Full Piece">
            </div>

            <div class="row g-3 mb-3">
              <!-- Category -->
              <div class="col-6">
                <label class="form-label small text-muted fw-bold">CATEGORY</label>
                <select class="form-select form-dark" ng-model="vm.editingTask.category">
                  <option ng-repeat="cat in vm.categories" value="{{cat}}">{{cat}}</option>
                </select>
              </div>

              <!-- Planned Duration -->
              <div class="col-6">
                <label class="form-label small text-muted fw-bold">PLANNED TIME (MINS)</label>
                <input type="number" class="form-control form-dark" ng-model="vm.editingTask.plannedMinutes" min="1" max="180" required>
              </div>
            </div>

            <!-- Focus Notes -->
            <div class="mb-3">
              <label class="form-label small text-muted fw-bold">TECHNIQUE & FOCUS GOALS</label>
              <textarea class="form-control form-dark" ng-model="vm.editingTask.notes" rows="3" placeholder="e.g. Trill clarity, slow hands together, steady tempo..."></textarea>
            </div>
          </div>

          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-outline-secondary btn-touch" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-info btn-touch text-dark fw-bold">Save Piece</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal: Session Analytics & History -->
  <div class="modal fade" id="statsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content modal-content-dark">
        <div class="modal-header border-secondary">
          <h5 class="modal-title fw-bold text-white">
            <i class="fa-solid fa-chart-pie text-info me-2"></i> Practice Session Analytics
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <div class="row g-3 mb-4">
            <div class="col-6 col-md-3 text-center p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
              <div class="small text-muted">Total Time Today</div>
              <div class="stand-text-lg font-monospace text-emerald" style="color: var(--accent-green)">
                {{ vm.formatTime(vm.sessionTotalSeconds) }}
              </div>
            </div>
            <div class="col-6 col-md-3 text-center p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
              <div class="small text-muted">Planned Total</div>
              <div class="stand-text-lg font-monospace text-info">
                {{ vm.getTotalPlannedMinutes() }} mins
              </div>
            </div>
            <div class="col-6 col-md-3 text-center p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
              <div class="small text-muted">Pieces Practiced</div>
              <div class="stand-text-lg font-monospace text-warning">
                {{ vm.getPracticedPiecesCount() }} / {{ vm.tasks.length }}
              </div>
            </div>
            <div class="col-6 col-md-3 text-center p-3 rounded-3" style="background: rgba(255,255,255,0.05);">
              <div class="small text-muted">Overall Goal Completion</div>
              <div class="stand-text-lg font-monospace text-purple" style="color: var(--accent-purple)">
                {{ vm.getOverallCompletionPercent() }}%
              </div>
            </div>
          </div>

          <!-- Category Breakdown Progress Bars -->
          <h6 class="fw-bold text-white mb-3">Time Spent by Category</h6>
          <div class="mb-3" ng-repeat="cat in vm.categories">
            <div class="d-flex justify-content-between small text-muted mb-1">
              <span>{{ cat }}</span>
              <span>{{ vm.formatTime(vm.getCategoryTimeSpent(cat)) }}</span>
            </div>
            <div class="progress">
              <div class="progress-bar" 
                   ng-class="vm.getCategoryBgClass(cat)"
                   ng-style="{'width': vm.getCategoryTimePercent(cat) + '%'}">
              </div>
            </div>
          </div>

          <!-- Session Log History -->
          <h6 class="fw-bold text-white mt-4 mb-2">Practice Switches History</h6>
          <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
            <table class="table table-dark table-sm small align-middle">
              <thead>
                <tr class="text-muted">
                  <th>Time</th>
                  <th>Piece</th>
                  <th>Measure Focus</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <tr ng-repeat="log in vm.sessionLogs | orderBy:'-timestamp'">
                  <td class="text-muted">{{ log.timestamp | date:'HH:mm:ss' }}</td>
                  <td class="fw-semibold text-white">{{ log.title }}</td>
                  <td class="text-info">{{ log.bars || '-' }}</td>
                  <td class="font-monospace text-emerald" style="color: var(--accent-green)">{{ vm.formatTime(log.durationSeconds) }}</td>
                </tr>
                <tr ng-if="vm.sessionLogs.length === 0">
                  <td colspan="4" class="text-center text-muted py-3">No completed practice switches recorded yet.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="modal-footer border-secondary">
          <button type="button" class="btn btn-outline-secondary btn-touch" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    /* PracticeTempo AngularJS Application Module */
    var app = angular.module('practiceTempoApp', []);

    app.controller('PracticeController', ['$scope', '$interval', '$window', function($scope, $interval, $window) {
      var vm = this;

      vm.categories = ['Warmup', 'Scales', 'Repertoire', 'Sight-reading', 'Technique'];
      vm.selectedCategory = 'All';
      vm.tasks = [];
      vm.activeTask = null;
      vm.isPaused = false;
      vm.sessionTotalSeconds = 0;
      vm.sessionLogs = [];
      vm.editingTask = {};
      
      // Timer reference
      var practiceTimer = null;
      var activeTaskStartTime = null;

      vm.showMetronome = false;
      vm.metronome = {
        bpm: 100,
        isPlaying: false,
        timeSignature: 4,
        currentBeat: 0
      };

      var audioCtx = null;
      var metronomeTimer = null;
      var tapTimestamps = [];

      // Initialize AudioContext on first gesture
      function getAudioContext() {
        if (!audioCtx) {
          var AudioContextClass = $window.AudioContext || $window.webkitAudioContext;
          if (AudioContextClass) {
            audioCtx = new AudioContextClass();
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      // Synthesize clean metronome tick sound
      function playClick(isAccent) {
        try {
          var ctx = getAudioContext();
          if (!ctx) return;

          var osc = ctx.createOscillator();
          var gain = ctx.createGain();

          osc.type = 'sine';
          // Pitch: Beat 1 accent = 1200Hz, normal beat = 800Hz
          osc.frequency.setValueAtTime(isAccent ? 1200 : 800, ctx.currentTime);

          gain.gain.setValueAtTime(1, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.04);

          osc.connect(gain);
          gain.connect(ctx.destination);

          osc.start(ctx.currentTime);
          osc.stop(ctx.currentTime + 0.04);
        } catch (e) {
          console.log('Audio error:', e);
        }
      }

      vm.toggleMetronomeDrawer = function() {
        vm.showMetronome = !vm.showMetronome;
      };

      vm.toggleMetronome = function() {
        getAudioContext();
        vm.metronome.isPlaying = !vm.metronome.isPlaying;
        if (vm.metronome.isPlaying) {
          vm.metronome.currentBeat = 0;
          startMetronomeLoop();
        } else {
          stopMetronomeLoop();
        }
      };

      function startMetronomeLoop() {
        stopMetronomeLoop();
        var intervalMs = (60 / vm.metronome.bpm) * 1000;
        
        // Play beat immediately
        playClick(vm.metronome.currentBeat === 0);
        
        metronomeTimer = $interval(function() {
          vm.metronome.currentBeat = (vm.metronome.currentBeat + 1) % vm.metronome.timeSignature;
          playClick(vm.metronome.currentBeat === 0);
        }, intervalMs);
      }

      function stopMetronomeLoop() {
        if (metronomeTimer) {
          $interval.cancel(metronomeTimer);
          metronomeTimer = null;
        }
      }

      vm.updateMetronomeTempo = function() {
        if (vm.metronome.isPlaying) {
          startMetronomeLoop();
        }
        vm.saveState();
      };

      vm.setBpm = function(val) {
        vm.metronome.bpm = val;
        vm.updateMetronomeTempo();
      };

      vm.adjustBpm = function(delta) {
        var newBpm = vm.metronome.bpm + delta;
        if (newBpm >= 30 && newBpm <= 250) {
          vm.metronome.bpm = newBpm;
          vm.updateMetronomeTempo();
        }
      };

      vm.setSignature = function(sig) {
        vm.metronome.timeSignature = sig;
        vm.metronome.currentBeat = 0;
        if (vm.metronome.isPlaying) {
          startMetronomeLoop();
        }
      };

      vm.getBeatArray = function() {
        return new Array(vm.metronome.timeSignature);
      };

      // Tap Tempo algorithm
      vm.tapTempo = function() {
        var now = Date.now();
        tapTimestamps.push(now);

        // Keep last 4 taps within 3 seconds
        tapTimestamps = tapTimestamps.filter(function(ts) {
          return now - ts < 3000;
        });

        if (tapTimestamps.length >= 2) {
          var intervals = [];
          for (var i = 1; i < tapTimestamps.length; i++) {
            intervals.push(tapTimestamps[i] - tapTimestamps[i - 1]);
          }
          var avgInterval = intervals.reduce(function(a, b) { return a + b; }, 0) / intervals.length;
          var calculatedBpm = Math.round(60000 / avgInterval);
          if (calculatedBpm >= 30 && calculatedBpm <= 250) {
            vm.metronome.bpm = calculatedBpm;
            vm.updateMetronomeTempo();
          }
        }
      };

      // Primary Practice Timer Ticker
      function startPracticeTimer() {
        if (practiceTimer) return;
        activeTaskStartTime = Date.now();

        practiceTimer = $interval(function() {
          if (vm.activeTask && !vm.isPaused) {
            vm.activeTask.secondsSpent++;
            vm.sessionTotalSeconds++;
            vm.saveState();
          }
        }, 1000);
      }

      function stopPracticeTimer() {
        if (practiceTimer) {
          $interval.cancel(practiceTimer);
          practiceTimer = null;
        }
      }

      // ONE-TAP TASK SWITCHING LOGIC
      vm.selectTask = function(task) {
        // If clicking the currently active task
        if (vm.activeTask && vm.activeTask.id === task.id) {
          vm.togglePauseTask();
          return;
        }

        // Log previous active task duration if exists
        if (vm.activeTask) {
          logPracticeSegment(vm.activeTask);
        }

        // Instantly switch to newly selected task
        vm.activeTask = task;
        vm.isPaused = false;
        activeTaskStartTime = Date.now();

        startPracticeTimer();
        vm.saveState();
      };

      vm.togglePauseTask = function() {
        if (!vm.activeTask) return;
        vm.isPaused = !vm.isPaused;
        if (vm.isPaused) {
          logPracticeSegment(vm.activeTask);
        } else {
          activeTaskStartTime = Date.now();
        }
      };

      vm.stopActiveTask = function() {
        if (vm.activeTask) {
          logPracticeSegment(vm.activeTask);
          vm.activeTask = null;
          vm.isPaused = false;
          stopPracticeTimer();
          vm.saveState();
        }
      };

      function logPracticeSegment(task) {
        if (!activeTaskStartTime) return;
        var elapsedSecs = Math.floor((Date.now() - activeTaskStartTime) / 1000);
        if (elapsedSecs > 2) {
          vm.sessionLogs.push({
            taskId: task.id,
            title: task.title,
            bars: task.bars,
            durationSeconds: elapsedSecs,
            timestamp: new Date()
          });
        }
        activeTaskStartTime = Date.now();
      }

      vm.filterCategory = function(cat) {
        vm.selectedCategory = cat;
      };

      vm.categoryFilter = function(task) {
        if (vm.selectedCategory === 'All') return true;
        return task.category === vm.selectedCategory;
      };

      // Task CRUD Operations
      vm.openAddTaskModal = function() {
        vm.editingTask = {
          title: '',
          bars: '',
          category: 'Repertoire',
          plannedMinutes: 15,
          notes: ''
        };
        var modalEl = document.getElementById('taskModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      };

      vm.openEditTaskModal = function(task) {
        vm.editingTask = angular.copy(task);
        var modalEl = document.getElementById('taskModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      };

      vm.saveTask = function() {
        if (!vm.editingTask.title) return;

        if (vm.editingTask.id) {
          // Update existing
          for (var i = 0; i < vm.tasks.length; i++) {
            if (vm.tasks[i].id === vm.editingTask.id) {
              vm.tasks[i] = angular.copy(vm.editingTask);
              if (vm.activeTask && vm.activeTask.id === vm.editingTask.id) {
                vm.activeTask = vm.tasks[i];
              }
              break;
            }
          }
        } else {
          // Create new
          var newTask = {
            id: 'task_' + Date.now(),
            title: vm.editingTask.title,
            bars: vm.editingTask.bars || '',
            category: vm.editingTask.category || 'Repertoire',
            notes: vm.editingTask.notes || '',
            plannedMinutes: vm.editingTask.plannedMinutes || 15,
            secondsSpent: 0
          };
          vm.tasks.push(newTask);
        }

        vm.saveState();

        var modalEl = document.getElementById('taskModal');
        var modal = bootstrap.Modal.getInstance(modalEl);
        if (modal) modal.hide();
      };

      vm.deleteTask = function(taskId) {
        if (confirm("Are you sure you want to delete this piece?")) {
          if (vm.activeTask && vm.activeTask.id === taskId) {
            vm.stopActiveTask();
          }
          vm.tasks = vm.tasks.filter(function(t) { return t.id !== taskId; });
          vm.saveState();
        }
      };

      vm.resetAllSessionPrompt = function() {
        if (confirm("Reset all practice timers for today? Your piece list will be preserved.")) {
          vm.stopActiveTask();
          vm.sessionTotalSeconds = 0;
          vm.sessionLogs = [];
          angular.forEach(vm.tasks, function(task) {
            task.secondsSpent = 0;
          });
          vm.saveState();
        }
      };

      vm.openStatsModal = function() {
        var modalEl = document.getElementById('statsModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      };

      vm.formatTime = function(totalSeconds) {
        if (!totalSeconds || isNaN(totalSeconds)) return "00:00";
        var hrs = Math.floor(totalSeconds / 3600);
        var mins = Math.floor((totalSeconds % 3600) / 60);
        var secs = totalSeconds % 60;

        var pad = function(n) { return n < 10 ? '0' + n : n; };

        if (hrs > 0) {
          return pad(hrs) + ":" + pad(mins) + ":" + pad(secs);
        }
        return pad(mins) + ":" + pad(secs);
      };

      vm.getTaskProgressPercent = function(task) {
        if (!task || !task.plannedMinutes) return 0;
        var plannedSeconds = task.plannedMinutes * 60;
        var pct = Math.round((task.secondsSpent / plannedSeconds) * 100);
        return Math.min(pct, 100);
      };

      vm.getProgressColorClass = function(pct) {
        if (pct < 40) return 'bg-info';
        if (pct < 85) return 'bg-warning';
        return 'bg-success';
      };

      vm.getCategoryClass = function(category) {
        switch (category) {
          case 'Warmup': return 'cat-warmup';
          case 'Scales': return 'cat-scales';
          case 'Repertoire': return 'cat-repertoire';
          case 'Sight-reading': return 'cat-sightreading';
          case 'Technique': return 'cat-technique';
          default: return 'cat-repertoire';
        }
      };

      vm.getCategoryBgClass = function(category) {
        switch (category) {
          case 'Warmup': return 'bg-warning';
          case 'Scales': return 'bg-primary';
          case 'Repertoire': return 'bg-purple';
          case 'Sight-reading': return 'bg-success';
          case 'Technique': return 'bg-danger';
          default: return 'bg-info';
        }
      };

      // Analytics Calculations
      vm.getTotalPlannedMinutes = function() {
        return vm.tasks.reduce(function(sum, t) { return sum + (t.plannedMinutes || 0); }, 0);
      };

      vm.getPracticedPiecesCount = function() {
        return vm.tasks.filter(function(t) { return t.secondsSpent > 0; }).length;
      };

      vm.getOverallCompletionPercent = function() {
        var totalPlannedSecs = vm.getTotalPlannedMinutes() * 60;
        if (totalPlannedSecs === 0) return 0;
        return Math.min(100, Math.round((vm.sessionTotalSeconds / totalPlannedSecs) * 100));
      };

      vm.getCategoryTimeSpent = function(category) {
        return vm.tasks
          .filter(function(t) { return t.category === category; })
          .reduce(function(sum, t) { return sum + (t.secondsSpent || 0); }, 0);
      };

      vm.getCategoryTimePercent = function(category) {
        if (vm.sessionTotalSeconds === 0) return 0;
        return Math.round((vm.getCategoryTimeSpent(category) / vm.sessionTotalSeconds) * 100);
      };

      vm.saveState = function() {
        var state = {
          tasks: vm.tasks,
          sessionTotalSeconds: vm.sessionTotalSeconds,
          sessionLogs: vm.sessionLogs,
          activeTaskId: vm.activeTask ? vm.activeTask.id : null,
          metronomeBpm: vm.metronome.bpm
        };
        $window.localStorage.setItem('practice_tempo_data', JSON.stringify(state));
      };

      vm.loadState = function() {
        var saved = $window.localStorage.getItem('practice_tempo_data');
        if (saved) {
          try {
            var data = JSON.parse(saved);
            vm.tasks = data.tasks || [];
            vm.sessionTotalSeconds = data.sessionTotalSeconds || 0;
            vm.sessionLogs = data.sessionLogs || [];
            if (data.metronomeBpm) vm.metronome.bpm = data.metronomeBpm;

            if (data.activeTaskId) {
              var found = vm.tasks.find(function(t) { return t.id === data.activeTaskId; });
              if (found) {
                vm.activeTask = found;
                vm.isPaused = true; // start paused when loaded
              }
            }
          } catch (e) {
            vm.loadDefaults();
          }
        } else {
          vm.loadDefaults();
        }
      };

      vm.loadDefaults = function() {
        vm.tasks = [
          {
            id: 'task_1',
            title: 'Chopin Nocturne Op. 9 No. 2',
            bars: 'm. 1-12 (Theme & Ornaments)',
            category: 'Repertoire',
            notes: 'Keep left hand accompaniment light and steady; smooth cadenza trills.',
            plannedMinutes: 15,
            secondsSpent: 420
          },
          {
            id: 'task_2',
            title: 'Bach Prelude in C Major (BWV 846)',
            bars: 'm. 1-19',
            category: 'Repertoire',
            notes: 'Clear articulation, maintain continuous pulse, even tone in arpeggios.',
            plannedMinutes: 10,
            secondsSpent: 300
          },
          {
            id: 'task_3',
            title: 'Hanon Exercise #1',
            bars: 'Full Exercise',
            category: 'Technique',
            notes: 'Lift 4th and 5th fingers cleanly. Practice Staccato then Legato at 100 BPM.',
            plannedMinutes: 10,
            secondsSpent: 600
          },
          {
            id: 'task_4',
            title: 'G Major & E Minor Arpeggios',
            bars: '4 Octaves',
            category: 'Warmup',
            notes: 'Focus on smooth thumb passage and light wrist turns.',
            plannedMinutes: 8,
            secondsSpent: 240
          },
          {
            id: 'task_5',
            title: 'Debussy - Clair de Lune',
            bars: 'm. 15-26 (Rubato section)',
            category: 'Sight-reading',
            notes: 'Count 9/8 subdivisions accurately. Voice top melody over rolling chords.',
            plannedMinutes: 12,
            secondsSpent: 0
          }
        ];
        vm.sessionTotalSeconds = 1560;
        vm.saveState();
      };

      // Initialize Application
      vm.loadState();
    }]);
  </script>
</body>
</html>
